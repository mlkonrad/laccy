[Desktop Entry]
Type=Application
Name=Laccy
Comment=Clipboard history
Exec=@BINDIR@/laccy
Icon=io.github.mlkonrad.Laccy
Terminal=false
Categories=GTK;Utility;
Keywords=clipboard;history;copy;paste;
StartupNotify=false
Actions=preferences;

[Desktop Action preferences]
Name=Preferences
Exec=@BINDIR@/laccy --preferences
